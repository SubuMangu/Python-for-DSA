      "1\n"
     ]
    }
   ],
   "source": [
    "def fun(a:int):\n",
    "    if a<=0:\n",
    "        return\n",
    "    print(a)\n",
    "    a=a-1\n",
    "    fun(a)\n",
    "fun(5)"
   ]
  }
